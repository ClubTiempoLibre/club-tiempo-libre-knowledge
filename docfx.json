{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "toc.yml"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "assets/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "templates/minimal"
    ],
    "globalMetadata": {
      "_appName": "Club Tiempo Libre",
      "_appTitle": "Base de conocimiento",
      "_appLogoPath": "assets/identidad-de-marca/ctl-verde-transparente.webp",
      "_appFooter": "Club Tiempo Libre",
      "_enableSearch": true,
      "_lang": "es"
    }
  }
}